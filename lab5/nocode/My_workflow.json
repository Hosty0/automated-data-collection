    {
      "parameters": {
        "jsCode": "const root = $('HTML Extract - list').first().json;\nconst baseUrl = 'https://quotes.toscrape.com';\n\nconst rows = (root.quoteTexts || []).map((quote, i) => {\n  const authorLink = String((root.authorLinks || [])[i] || '').trim();\n\n  return {\n    quote: String(quote || '').trim(),\n    author: String((root.authors || [])[i] || '').trim(),\n    authorUrl: authorLink.startsWith('http')\n      ? authorLink\n      : baseUrl + (authorLink.startsWith('/') ? authorLink : '/' + authorLink),\n    sourceUrl: baseUrl + '/',\n    tags: []\n  };\n});\n\nreturn rows.map(row => ({ json: row }));"
      },
